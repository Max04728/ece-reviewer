# Both machines must see identical bytes.
# Windows has core.autocrlf=true globally; the Android tablet does not.
# Without this, git would hand the tablet CRLF files on checkout and the
# generated vault would differ from the desktop copy.
* text=auto eol=lf

# Never normalize assets
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.pdf  binary
*.woff binary
*.woff2 binary
